# Copy to `.env` and adjust. Real environment variables win over this file.
# Every variable is optional; the defaults suit local development.

# Required when DEBUG is off: make it long, random and private.
WEBXIANG_SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# Albums (RUN_DIR/albums), photos (RUN_DIR/data) and optional template and
# static overrides (RUN_DIR/templates, RUN_DIR/static). Relative paths are
# resolved against the project root.
RUN_DIR=run
# ALBUM_DIR=
# WEBXIANG_PHOTOS_ROOT=
WEBXIANG_PHOTOS_URL=/data/
STATIC_URL=/static/

SITE_URL=https://www.example.org/
COPYRIGHT_OWNER=Your Name

# CACHE_BACKEND=django.core.cache.backends.memcached.PyMemcacheCache
# CACHE_LOCATION=127.0.0.1:11211

# leaflet or mapbox
GEO_MAP_PLUGIN=leaflet
# MAPBOX_ACCESS_TOKEN=

# For settings not covered here, create webxiang/settings_local.py.
